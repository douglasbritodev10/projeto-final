{% extends 'app/layout.html.twig' %}

{% block title %}Nova categoria{% endblock %}

{% block conteudo %}
    <h1>Nova categoria</h1>

    <form action="{{ path('salvar_categoria') }}" method="POST" class="w-50 mt-3">
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" maxlength="50" required>
        </div>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
        <a href="{{ path('listar_categorias') }}" class="btn btn-secondary">Voltar</a>
    </form>
{% endblock %}

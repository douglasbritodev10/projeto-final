{% extends 'app/layout.html.twig' %}

{% block title %}Produtos{% endblock %}

{% block conteudo %}
    <h1>Produtos</h1>

    <a href="{{ path('cadastrar_produto') }}" class="btn btn-primary mb-3">Novo produto</a>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Estoque</th>
                <th>Valor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {% for produto in produtos %}
                <tr>
                    <td>{{ produto.id }}</td>
                    <td>{{ produto.nome }}</td>
                    <td>{{ produto.categoria.nome }}</td>
                    <td>{{ produto.quantidadeDisponivel }}</td>
                    <td>R$ {{ produto.valor|number_format(2, ',', '.') }}</td>
                    <td>
                        <form action="{{ path('adicionar_produto', {id: produto.id}) }}" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">+1</button>
                        </form>
                        <form action="{{ path('vender_produto', {id: produto.id}) }}" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">Vender</button>
                        </form>
                        <a href="{{ path('editar_produto', {id: produto.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form action="{{ path('remover_produto', {id: produto.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Deseja excluir este produto?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Nenhum produto cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
